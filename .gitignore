# JetBrains IDE project settings, specific to each developer
.idea
# macOS folder metadata, never part of the source
.DS_Store
# VS Code workspace settings, specific to each developer
.vscode
# Rollup plugin cache, regenerated on every build
.rollup.cache
# Test coverage reports, regenerated by the coverage script
coverage
# Installed dependencies, restored with npm ci
node_modules
# Compiled build output, regenerated by npm run build
dist
# Scratch files kept out of version control
temp
